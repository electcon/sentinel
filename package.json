{
  "name": "sentinel",
  "version": "0.0.1",
  "private": true,
  "description": "Defensive social-media + threat-monitoring platform for Dem-aligned campaigns. Codename Sentinel.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "init-db": "node scripts/init-db.js",
    "seed-dev": "node scripts/seed-dev.js",
    "ingest:reddit": "node workers/reddit.js",
    "ingest:bluesky": "node workers/bluesky.js",
    "ingest:rss": "node workers/rss.js",
    "ingest:x": "node workers/x.js",
    "alert:run": "node workers/alert.js",
    "digest:run": "node workers/digest.js",
    "digest:force": "node workers/digest.js --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "pg": "^8.13.0",
    "resend": "^4.0.0"
  }
}
