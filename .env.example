# Sentinel — env template. Copy to .env, fill in.
# DO NOT commit .env. Render's env-vars panel is the canonical store
# in deployed environments.

# ── Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/sentinel

# ── LLM ─────────────────────────────────────────────────────────────
# Claude Haiku 4.5 is the default classifier; Sonnet 4.6 escalation
# for low-confidence calls.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_ESCALATE=claude-sonnet-4-6

# ── Object storage (evidence preservation) ──────────────────────────
S3_BUCKET=sentinel-evidence
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── Email (alerts + daily digests) ──────────────────────────────────
RESEND_API_KEY=re_...
ALERT_FROM=Sentinel Alerts <alerts@sentinel.example>
DIGEST_FROM=Sentinel Daily <daily@sentinel.example>

# ── Source credentials ──────────────────────────────────────────────
# Reddit: register an app at https://www.reddit.com/prefs/apps for
# OAuth client credentials. Free tier sufficient for v1.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentinel/0.0.1 (by /u/your-handle)

# Bluesky: AT-Proto identifier + app password. Create at
# https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Public Facebook Pages: Graph API requires a long-lived page-access
# token per page being monitored. https://developers.facebook.com/tools/explorer
FACEBOOK_GRAPH_TOKEN=

# RSS feeds are unauthenticated; configured in DB per-customer.

# ── Server ──────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=development
SENTINEL_BASE_URL=http://localhost:10000

# ── Auth (v1: shared password per customer) ─────────────────────────
# Replaced by SSO in v2. Set per-customer via the customers.password_hash
# column once the schema is live.
ADMIN_PASSWORD=change-me-only-for-local-dev
